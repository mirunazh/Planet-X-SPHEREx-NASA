{
  "name": "spherex-time-viewer",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "node scripts/sync-assets.mjs",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -p 3100",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -p 3100",
    "pretest": "node scripts/sync-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@stylexjs/stylex": "0.19.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
